# Supabase credentials — copy this file to .env.local and fill in real values.
# Find these in your Supabase project: Settings → API.
# Both are safe to expose in the browser (anon key is public by design),
# but .env.local is git-ignored so your project URL stays out of the repo.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
